<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarm_ringing_screen"
    android:paddingStart="28dp"
    android:paddingTop="32dp"
    android:paddingEnd="28dp"
    android:paddingBottom="36dp"
    tools:context=".alarm.AlarmRingingActivity">

    <LinearLayout
        android:id="@+id/alarm_clock_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/alarm_snooze_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.38">

        <TextView
            android:id="@+id/alarm_time_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:textColor="#FFF8EE"
            android:textSize="80sp"
            app:autoSizeMaxTextSize="80sp"
            app:autoSizeMinTextSize="56sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            tools:text="07:00" />

        <TextView
            android:id="@+id/alarm_date_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.01"
            android:textColor="#E6FFF8EE"
            android:textSize="21sp"
            app:autoSizeMaxTextSize="21sp"
            app:autoSizeMinTextSize="17sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            tools:text="7월 24일 금요일" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/alarm_snooze_button"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#29313F57"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:stateListAnimator="@null"
        android:text="@string/alarm_ringing_snooze"
        android:textAllCaps="false"
        android:textColor="#FFF8EE"
        android:textSize="17sp"
        app:cornerRadius="29dp"
        app:layout_constraintBottom_toTopOf="@id/alarm_dismiss_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintWidth_max="420dp"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#66FFFFFF"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/alarm_dismiss_button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:backgroundTint="#FFF4E5"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:stateListAnimator="@null"
        android:text="@string/alarm_ringing_dismiss"
        android:textAllCaps="false"
        android:textColor="#1D2340"
        android:textSize="19sp"
        app:cornerRadius="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintWidth_max="420dp"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
