<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_alarm_time_edit_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <TextView
        android:id="@+id/time_edit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/alarm_time_edit_title"
        android:textColor="@color/lura_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/time_mode_selector"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_time_mode_group"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/sleep_time_mode_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_time_mode_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/sleep_start_time_picker_label"
            android:textColor="@color/lura_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wake_time_mode_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_time_mode_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/wake_alarm_time_picker_label"
            android:textColor="@color/lura_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/time_picker_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:textColor="@color/lura_text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="@string/sleep_start_time_picker_label" />

    <LinearLayout
        android:id="@+id/time_picker_row"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.won1203.lura.WheelPickerView
            android:id="@+id/period_picker"
            android:layout_width="96dp"
            android:layout_height="match_parent" />

        <com.won1203.lura.WheelPickerView
            android:id="@+id/hour_picker"
            android:layout_width="84dp"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/time_separator"
            android:textColor="@color/lura_time_picker_text"
            android:textSize="40sp"
            android:textStyle="bold" />

        <com.won1203.lura.WheelPickerView
            android:id="@+id/minute_picker"
            android:layout_width="84dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/time_summary_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_time_mode_group"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/sleep_start_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/lura_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="수면 시작 시간  오후 11:00" />

        <TextView
            android:id="@+id/wake_alarm_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/lura_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="기상 알람 시간  오전 7:00" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_time_edit_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/cancel_alarm"
            android:textColor="@color/lura_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_time_edit_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/save_alarm_short"
            android:textColor="@color/lura_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>
