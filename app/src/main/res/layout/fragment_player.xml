<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lura_background"
    android:fillViewport="true"
    tools:context=".PlayerFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/player_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mood_chip"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/player_eyebrow"
            android:textColor="@color/lura_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:includeFontPadding="false"
            android:textColor="@color/lura_text_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="창문 너머 밤비" />

        <TextView
            android:id="@+id/player_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/lura_text_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="빗소리" />

        <TextView
            android:id="@+id/player_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/lura_text_secondary"
            android:textSize="14sp"
            tools:text="수면 · 잔잔함 · 비" />

        <TextView
            android:id="@+id/player_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/lura_text_secondary"
            android:textSize="14sp"
            tools:text="45분" />

        <TextView
            android:id="@+id/player_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/player_status_disconnected"
            android:textColor="@color/lura_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/player_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/play_pause_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lura_accent"
                android:enabled="false"
                android:text="@string/player_pause"
                android:textColor="@color/lura_background"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_pause_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/lura_background" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stop_playback_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="112dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:enabled="false"
                android:text="@string/player_stop"
                android:textColor="@color/lura_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_stop_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/lura_text_primary"
                app:strokeColor="@color/lura_stroke" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
