<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarm_ringing_screen"
    android:paddingStart="32dp"
    android:paddingTop="76dp"
    android:paddingEnd="32dp"
    android:paddingBottom="40dp"
    tools:context=".alarm.AlarmRingingActivity">

    <TextView
        android:id="@+id/alarm_time_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0"
        android:textColor="@android:color/white"
        android:textSize="64sp"
        app:autoSizeMaxTextSize="64sp"
        app:autoSizeMinTextSize="48sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="7:00" />

    <TextView
        android:id="@+id/alarm_date_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0"
        android:textColor="@android:color/white"
        android:textSize="21sp"
        app:autoSizeMaxTextSize="21sp"
        app:autoSizeMinTextSize="17sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alarm_time_text"
        tools:text="7월 12일 화요일" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/alarm_snooze_button"
        android:layout_width="132dp"
        android:layout_height="56dp"
        android:layout_marginTop="43dp"
        android:backgroundTint="#33243B"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:stateListAnimator="@null"
        android:text="@string/alarm_ringing_snooze"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        app:cornerRadius="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alarm_date_text" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/alarm_dismiss_button"
        android:layout_width="171dp"
        android:layout_height="63dp"
        android:layout_marginTop="53dp"
        android:backgroundTint="#FF8A00"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:stateListAnimator="@null"
        android:text="@string/alarm_ringing_dismiss"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="19sp"
        app:cornerRadius="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alarm_snooze_button" />

</androidx.constraintlayout.widget.ConstraintLayout>
